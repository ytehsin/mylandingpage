                <button id="tab-btn-case" onclick="switchStudioTab('case')" class="px-3 py-1.5 border border-theme rounded-sm lang-switch-inactive">2. Case Studies</button>
                <button id="tab-btn-testimonials" onclick="switchStudioTab('testimonials')" class="px-3 py-1.5 border border-theme rounded-sm lang-switch-inactive">3. Testimonials & Clients</button>
                <button id="tab-btn-publications" onclick="switchStudioTab('publications')" class="px-3 py-1.5 border border-theme rounded-sm lang-switch-inactive">4. Publications (Books)</button>
                <button id="tab-btn-ui" onclick="switchStudioTab('ui')" class="px-3 py-1.5 border border-theme rounded-sm lang-switch-inactive">5. Edit Everything & Buttons</button>
                <button id="tab-btn-seo" onclick="switchStudioTab('seo')" class="px-3 py-1.5 border border-theme rounded-sm lang-switch-inactive">6. Live SEO Check</button>
            </div>

            <!-- TAB 1: BLOG PUBLISHER (With Image Upload & URL Support) -->
            <div id="studio-tab-blog" class="space-y-6 text-xs sm:text-sm">
                <div class="border border-theme p-5 rounded-sm bg-brand-light/30 space-y-4">
                    <div class="flex justify-between items-center">
                        <h4 id="blog-form-heading" class="font-serif text-base text-brand-ink">Publish a New Blog Post (With Optional Cover Image)</h4>
                        <button onclick="resetBlogForm()" class="text-xs uppercase tracking-wider text-brand-secondary hover:text-brand-ink">Clear Form</button>
                    </div>
                    <input type="hidden" id="edit-blog-id" value="">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Category</label>
                            <input id="new-blog-cat" type="text" placeholder="e.g., AI & Linguistics" class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Date Label</label>
                            <input id="new-blog-date" type="text" placeholder="e.g., Oct 2026" class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">External / LinkedIn URL (Optional)</label>
                            <input id="new-blog-link" type="url" placeholder="https://www.linkedin.com/in/yasirtehsin/" class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Article Title</label>
                        <input id="new-blog-title" type="text" placeholder="Enter your headline..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                    </div>

                    <!-- Blog Cover Image Upload or URL -->
                    <div class="border border-theme p-3.5 rounded-sm bg-brand-paper space-y-3">
                        <div class="flex flex-wrap justify-between items-center gap-2">
                            <label class="block text-xs uppercase tracking-wider text-brand-secondary">Featured Image (Upload File or Paste Image URL)</label>
                            <button type="button" onclick="clearBlogImageInput()" class="text-[11px] uppercase tracking-wider text-brand-secondary hover:text-brand-ink">Remove Image</button>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-center">
                            <input id="new-blog-img-url" type="text" placeholder="Paste image URL or path (e.g., ./blog-cover.jpg)" oninput="previewBlogImageUrl(this.value)" class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm text-xs">
                            <label class="border border-theme px-3 py-2 rounded-sm text-xs uppercase tracking-wider text-brand-ink hover:bg-brand-light transition-colors cursor-pointer flex items-center justify-center gap-2">
                                <i class="fas fa-upload"></i> <span>Upload Image from Device</span>
                                <input id="new-blog-img-file" type="file" accept="image/*" class="hidden" onchange="handleBlogImageUpload(event)">
                            </label>
                        </div>
                        <div id="new-blog-img-preview-wrap" class="hidden pt-2">
                            <img id="new-blog-img-preview" src="" alt="Blog image preview" class="h-28 w-auto object-cover border border-theme rounded-sm">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Short Card Summary</label>
                        <textarea id="new-blog-desc" rows="2" placeholder="2-sentence summary shown on the Blog card..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm"></textarea>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Full Article Body (Paragraphs separated by blank lines)</label>
                        <textarea id="new-blog-body" rows="5" placeholder="Write or paste your full article here..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm"></textarea>
                    </div>
                    <div class="flex justify-end">
                        <button onclick="saveBlogPost()" class="border border-brand-ink bg-brand-ink text-brand-paper px-5 py-2 text-xs uppercase tracking-wider rounded-sm hover:bg-transparent hover:text-brand-ink transition-colors">
                            <i class="fas fa-check mr-1"></i> Save & Publish Blog Post
                        </button>
                    </div>
                </div>

                <div>
                    <h4 class="text-xs uppercase tracking-widest text-brand-secondary mb-3">Existing Blog Posts (Click Edit or Delete)</h4>
                    <div id="studio-blog-list" class="space-y-2"></div>
                </div>
            </div>

            <!-- TAB 2: CASE STUDIES MANAGER -->
            <div id="studio-tab-case" class="hidden space-y-6 text-xs sm:text-sm">
                <div class="border border-theme p-5 rounded-sm bg-brand-light/30 space-y-4">
                    <div class="flex justify-between items-center">
                        <h4 id="case-form-heading" class="font-serif text-base text-brand-ink">Add or Edit a Portfolio Case Study</h4>
                        <button onclick="resetCaseForm()" class="text-xs uppercase tracking-wider text-brand-secondary hover:text-brand-ink">Clear Form</button>
                    </div>
                    <input type="hidden" id="edit-case-id" value="">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Category Tag</label>
                            <input id="new-case-tag" type="text" placeholder="e.g., Workflow Automation" class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">FontAwesome Icon Class</label>
                            <input id="new-case-icon" type="text" placeholder="e.g., fab fa-python or fas fa-robot" class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Case Study Title</label>
                        <input id="new-case-title" type="text" placeholder="e.g., Automating Glossary Updates with Python" class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Card Summary</label>
                        <textarea id="new-case-desc" rows="2" placeholder="Summary displayed on the portfolio card..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm"></textarea>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Modal Full Breakdown (HTML or Paragraphs)</label>
                        <textarea id="new-case-body" rows="4" placeholder="Detailed breakdown shown when clicked..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm"></textarea>
                    </div>
                    <div class="flex justify-end">
                        <button onclick="saveCaseStudy()" class="border border-brand-ink bg-brand-ink text-brand-paper px-5 py-2 text-xs uppercase tracking-wider rounded-sm hover:bg-transparent hover:text-brand-ink transition-colors">
                            <i class="fas fa-check mr-1"></i> Save Case Study
                        </button>
                    </div>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-widest text-brand-secondary mb-3">Existing Case Studies</h4>
                    <div id="studio-case-list" class="space-y-2"></div>
                </div>
            </div>

            <!-- TAB 3: TESTIMONIALS & CLIENTS MANAGER -->
            <div id="studio-tab-testimonials" class="hidden space-y-6 text-xs sm:text-sm">
                <div class="border border-theme p-5 rounded-sm bg-brand-light/30 space-y-4">
                    <div class="flex justify-between items-center">
                        <h4 id="test-form-heading" class="font-serif text-base text-brand-ink">Add or Edit a Client Testimonial</h4>
                        <button onclick="resetTestimonialForm()" class="text-xs uppercase tracking-wider text-brand-secondary hover:text-brand-ink">Clear Form</button>
                    </div>
                    <input type="hidden" id="edit-test-id" value="">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Author Name / Role</label>
                            <input id="new-test-author" type="text" placeholder="e.g., Localization Project Manager" class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Organization / Context</label>
                            <input id="new-test-org" type="text" placeholder="e.g., Enterprise Language & Tech Partner" class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Testimonial Quote</label>
                        <textarea id="new-test-quote" rows="3" placeholder="Enter client feedback quote..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm"></textarea>
                    </div>
                    <div class="flex justify-end">
                        <button onclick="saveTestimonial()" class="border border-brand-ink bg-brand-ink text-brand-paper px-5 py-2 text-xs uppercase tracking-wider rounded-sm hover:bg-transparent hover:text-brand-ink transition-colors">
                            <i class="fas fa-check mr-1"></i> Save Testimonial
                        </button>
                    </div>
                </div>

                <div>
                    <h4 class="text-xs uppercase tracking-widest text-brand-secondary mb-3">Existing Testimonials</h4>
                    <div id="studio-test-list" class="space-y-2"></div>
                </div>

                <div class="border-t border-theme pt-6 space-y-4">
                    <h4 class="font-serif text-base text-brand-ink">Add or Edit Client Showcase</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <input id="new-client-name" type="text" placeholder="Client Name (e.g., FidelTech)" class="border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        <input id="new-client-sub" type="text" placeholder="Descriptor (e.g., Localization & Tech)" class="border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        <button onclick="addClientLogo()" class="border border-brand-ink bg-brand-ink text-brand-paper px-4 py-2 text-xs uppercase tracking-wider rounded-sm hover:bg-transparent hover:text-brand-ink transition-colors">
                            + Add Client
                        </button>
                    </div>
                    <div id="studio-client-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
                </div>
            </div>

            <!-- TAB 4: PUBLICATIONS (BOOKS) MANAGER -->
            <div id="studio-tab-publications" class="hidden space-y-6 text-xs sm:text-sm">
                <div class="border border-theme p-5 rounded-sm bg-brand-light/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h4 class="font-serif text-base text-brand-ink mb-1">Public Visibility of Books & Publications Section</h4>
                        <p class="text-xs text-brand-secondary">By default, this section is <strong>hidden from the general public</strong> while empty. Toggle visibility ON whenever you are ready to showcase your published books.</p>
                    </div>
                    <button id="pub-toggle-btn" onclick="togglePublicationsVisibility()" class="border border-brand-ink px-4 py-2 text-xs uppercase tracking-wider rounded-sm hover:bg-brand-ink hover:text-brand-paper transition-colors whitespace-nowrap">
                        Public Visibility: OFF
                    </button>
                </div>

                <div class="border border-theme p-5 rounded-sm bg-brand-light/20 space-y-4">
                    <div class="flex justify-between items-center">
                        <h4 id="pub-form-heading" class="font-serif text-base text-brand-ink">Add a Book or Publication</h4>
                        <button onclick="resetPublicationForm()" class="text-xs uppercase tracking-wider text-brand-secondary hover:text-brand-ink">Clear Form</button>
                    </div>
                    <input type="hidden" id="edit-pub-id" value="">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Book Title</label>
                            <input id="new-pub-title" type="text" placeholder="Enter book or anthology title..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Role / Format & Year</label>
                            <input id="new-pub-meta" type="text" placeholder="e.g., Author • Poetry Collection • 2026" class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Purchase / Archive Link (Optional)</label>
                            <input id="new-pub-link" type="url" placeholder="https://..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Synopsis / Publication Details</label>
                        <textarea id="new-pub-desc" rows="3" placeholder="Describe the book, publisher, language, or literary theme..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm"></textarea>
                    </div>
                    <div class="flex justify-end">
                        <button onclick="savePublication()" class="border border-brand-ink bg-brand-ink text-brand-paper px-5 py-2 text-xs uppercase tracking-wider rounded-sm hover:bg-transparent hover:text-brand-ink transition-colors">
                            <i class="fas fa-check mr-1"></i> Save Book / Publication
                        </button>
                    </div>
                </div>

                <div>
                    <h4 class="text-xs uppercase tracking-widest text-brand-secondary mb-3">Saved Books & Publications</h4>
                    <div id="studio-pub-list" class="space-y-2"></div>
                </div>
            </div>

            <!-- TAB 5: EXTEND UI, BUTTON NAMES & INLINE EDITING -->
            <div id="studio-tab-ui" class="hidden space-y-6 text-xs sm:text-sm">
                <div class="border border-theme p-5 rounded-sm bg-brand-light/30 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h4 class="font-serif text-base text-brand-ink mb-1">Direct On-Page Editing (Text, Headings & Button Names)</h4>
                        <p class="text-xs text-brand-secondary">When enabled, click any heading, paragraph, metric, table cell, or <strong>button name</strong> directly on the page to edit it. Visitors never see these controls.</p>
                    </div>
                    <button id="inline-edit-toggle-btn" onclick="toggleInlineEditMode()" class="border border-brand-ink px-4 py-2 text-xs uppercase tracking-wider rounded-sm hover:bg-brand-ink hover:text-brand-paper transition-colors whitespace-nowrap">
                        Enable Inline Editing
                    </button>
                </div>

                <!-- Button & UI Labels Editor (EN & HI) -->
                <div class="border border-theme p-5 rounded-sm space-y-4">
                    <div class="flex flex-wrap justify-between items-center gap-2">
                        <div>
                            <h4 class="font-serif text-base text-brand-ink">Edit All Button Names & Navigation Labels (EN & HI)</h4>
                            <p class="text-xs text-brand-secondary">Customize any button or interface label across both English and Hindi modes.</p>
                        </div>
                        <button onclick="saveAllButtonLabels()" class="border border-brand-ink bg-brand-ink text-brand-paper px-4 py-1.5 text-xs uppercase tracking-wider rounded-sm hover:bg-transparent hover:text-brand-ink transition-colors">
                            Save Button Labels
                        </button>
                    </div>
                    <div id="studio-button-labels-grid" class="grid grid-cols-1 md:grid-cols-2 gap-3 max-h-60 overflow-y-auto pr-1"></div>
                </div>

                <!-- Add Custom Section Builder -->
                <div class="border border-theme p-5 rounded-sm space-y-4">
                    <h4 class="font-serif text-base text-brand-ink">Add a New Custom Section to Home Page</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Section Overline Label</label>
                            <input id="custom-sec-sub" type="text" placeholder="e.g., Selected Honors / Speaking" class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Section Main Heading</label>
                            <input id="custom-sec-title" type="text" placeholder="e.g., Workshops & Industry Panels" class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-brand-secondary mb-1">Section Content / Cards (Separate multiple cards with --- on a new line)</label>
                        <textarea id="custom-sec-content" rows="4" placeholder="Card 1 Title: Description text here...&#10;---&#10;Card 2 Title: Description text here..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2 rounded-sm"></textarea>
                    </div>
                    <div class="flex justify-end">
                        <button onclick="addCustomSection()" class="border border-brand-ink bg-brand-ink text-brand-paper px-4 py-2 text-xs uppercase tracking-wider rounded-sm hover:bg-transparent hover:text-brand-ink transition-colors">
                            <i class="fas fa-plus mr-1"></i> Append Section to Page
                        </button>
                    </div>
                    <div id="studio-custom-sec-list" class="space-y-2 pt-2"></div>
                </div>

                <!-- Owner Password Change & Session Controls -->
                <div class="border border-theme p-5 rounded-sm space-y-4">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div>
                            <h4 class="font-serif text-base text-brand-ink">Security & Change Owner Password</h4>
                            <p class="text-xs text-brand-secondary">Update your private owner password. After changing, click "Download Updated HTML" above to permanently save the new password into your site file.</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="lockOwnerSession()" class="border border-theme px-3 py-1.5 text-xs uppercase tracking-wider text-brand-secondary hover:text-brand-ink rounded-sm">
                                Lock Admin Session
                            </button>
                            <button onclick="resetAllSiteData()" class="border border-theme px-3 py-1.5 text-xs uppercase tracking-wider text-brand-secondary hover:text-brand-ink rounded-sm">
                                Reset Defaults
                            </button>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 pt-2">
                        <input id="cms-current-pass" type="password" placeholder="Current password" class="border border-theme bg-brand-paper text-brand-ink px-3 py-2 rounded-sm text-xs focus:outline-none focus:border-brand-ink">
                        <input id="cms-new-pass" type="password" placeholder="New password" class="border border-theme bg-brand-paper text-brand-ink px-3 py-2 rounded-sm text-xs focus:outline-none focus:border-brand-ink">
                        <input id="cms-confirm-pass" type="password" placeholder="Confirm new password" class="border border-theme bg-brand-paper text-brand-ink px-3 py-2 rounded-sm text-xs focus:outline-none focus:border-brand-ink">
                        <button type="button" onclick="updateOwnerPasscode()" class="border border-brand-ink bg-brand-ink text-brand-paper px-4 py-2 text-xs uppercase tracking-wider rounded-sm hover:bg-transparent hover:text-brand-ink transition-colors">
                            Change Password
                        </button>
                    </div>
                    <p id="cms-pass-feedback" class="hidden text-xs"></p>
                </div>
            </div>

            <!-- TAB 6: LIVE SEO & AI READINESS CHECKER -->
            <div id="studio-tab-seo" class="hidden space-y-4 text-xs sm:text-sm">
                <div class="border border-theme p-5 rounded-sm bg-brand-light/30">
                    <div class="flex justify-between items-center mb-2">
                        <h4 class="font-serif text-base text-brand-ink">Real-Time Technical SEO & AI Knowledge Graph Audit</h4>
                        <span id="seo-score-badge" class="px-3 py-1 bg-brand-ink text-brand-paper text-xs uppercase tracking-widest rounded-sm">100% Passed</span>
                    </div>
                    <p class="text-xs text-brand-secondary">Live verification of search engine indexing, entity corroboration (`sameAs`), schema.org `@graph` integrity, and multilingual tags on this page.</p>
                </div>
                <div id="seo-audit-results" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
            </div>
        </div>
    </div>

    <!-- 6. Private Owner Authentication Modal (Triggered via Alt+E, ?edit=1, or subtle footer lock) -->
    <div id="owner-auth-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" onclick="if(event.target === this) closeOwnerAuthModal()">
        <div class="bg-brand-paper border border-theme rounded-sm max-w-md w-full p-8 relative shadow-2xl">
            <button onclick="closeOwnerAuthModal()" class="absolute top-5 right-5 text-brand-secondary hover:text-brand-ink text-lg" aria-label="Close">
                <i class="fas fa-times"></i>
            </button>
            <span class="text-[11px] uppercase tracking-widest text-brand-secondary block mb-1">Owner-Only Access</span>
            <h3 class="text-xl font-serif text-brand-ink mb-2 font-normal">Unlock Site Studio & Inline Editor</h3>
            <p class="text-xs text-brand-secondary mb-5 leading-relaxed">Enter your private owner password to edit text, button names, blogs, and sections.</p>

            <!-- Standard Unlock Form -->
            <form id="owner-login-form" onsubmit="verifyOwnerPasscode(event)" class="space-y-4">
                <input id="owner-auth-pass" type="password" placeholder="Enter owner password..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2.5 rounded-sm text-sm focus:outline-none focus:border-brand-ink">
                <p id="owner-auth-error" class="hidden text-xs text-red-600">Incorrect password. Please try again.</p>
                <div class="flex items-center justify-between pt-2">
                    <button type="button" onclick="toggleModalPasswordChange(true)" class="text-xs uppercase tracking-wider text-brand-secondary hover:text-brand-ink underline">
                        Change Password
                    </button>
                    <div class="flex gap-2">
                        <button type="button" onclick="closeOwnerAuthModal()" class="border border-theme px-4 py-2 rounded-sm text-xs uppercase tracking-wider text-brand-secondary hover:text-brand-ink">Cancel</button>
                        <button type="submit" class="border border-brand-ink bg-brand-ink text-brand-paper px-5 py-2 rounded-sm text-xs uppercase tracking-wider hover:bg-transparent hover:text-brand-ink transition-colors">Unlock Studio</button>
                    </div>
                </div>
            </form>

            <!-- Direct Change Password Form inside Modal -->
            <form id="owner-change-pw-form" onsubmit="handleModalPasswordChange(event)" class="hidden space-y-3 pt-2 border-t border-theme">
                <div class="text-xs uppercase tracking-wider text-brand-ink font-bold">Change Owner Password</div>
                <input id="modal-current-pass" type="password" placeholder="Current password..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2.5 rounded-sm text-xs focus:outline-none focus:border-brand-ink">
                <input id="modal-new-pass" type="password" placeholder="New password..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2.5 rounded-sm text-xs focus:outline-none focus:border-brand-ink">
                <input id="modal-confirm-pass" type="password" placeholder="Confirm new password..." class="w-full border border-theme bg-brand-paper text-brand-ink p-2.5 rounded-sm text-xs focus:outline-none focus:border-brand-ink">
                <p id="modal-pw-feedback" class="hidden text-xs"></p>
                <div class="flex items-center justify-between pt-2">
                    <button type="button" onclick="toggleModalPasswordChange(false)" class="text-xs uppercase tracking-wider text-brand-secondary hover:text-brand-ink underline">
                        ← Back to Login
                    </button>
                    <button type="submit" class="border border-brand-ink bg-brand-ink text-brand-paper px-4 py-2 rounded-sm text-xs uppercase tracking-wider hover:bg-transparent hover:text-brand-ink transition-colors">
                        Save New Password
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Floating Studio Edit Mode Banner (Only visible when Inline Edit Mode is active) -->
    <div id="studio-bar" class="fixed bottom-6 left-6 z-50 hidden items-center gap-3 bg-brand-ink text-brand-paper px-4 py-3 rounded-sm shadow-xl text-xs uppercase tracking-wider">
        <span class="flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span> Inline Edit Mode Active (Click any text or button to edit)</span>
        <button onclick="openStudioDrawer('blog')" class="border border-brand-paper/40 px-2.5 py-1 rounded-sm hover:bg-brand-paper hover:text-brand-ink transition-colors">+ Blog</button>
        <button onclick="exportUpdatedHTML()" class="border border-brand-paper/40 px-2.5 py-1 rounded-sm hover:bg-brand-paper hover:text-brand-ink transition-colors">Export HTML</button>
        <button onclick="toggleInlineEditMode()" class="bg-brand-paper text-brand-ink px-2.5 py-1 rounded-sm font-bold">Done</button>
    </div>

    <div id="chatbot-container" class="fixed bottom-6 right-6 z-50 flex flex-col items-end font-sans">
        <!-- Chat Window -->
        <div id="chat-window" class="hidden mb-4 w-80 sm:w-96 bg-brand-paper border border-theme rounded-sm flex-col origin-bottom-right transition-all duration-300 scale-95 opacity-0 shadow-lg">
            <!-- Header -->
            <div class="bg-brand-light border-b border-theme p-4 flex justify-between items-center text-brand-ink">
                <div class="flex items-center gap-3">
                    <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
                    <div>
                        <span class="font-sans text-xs font-bold uppercase tracking-widest block" data-ui="chat_title">Virtual Assistant</span>
                        <span class="text-[10px] text-brand-secondary uppercase tracking-wider block" data-ui="chat_subtitle">AI Training • Localization • Poetry • Quotes</span>
                    </div>
                </div>
                <button onclick="toggleChat()" class="text-brand-secondary hover:text-brand-ink transition-colors" aria-label="Close Chat"><i class="fas fa-times"></i></button>
            </div>
            
            <!-- Messages Area -->
            <div id="chat-messages" class="p-4 h-72 overflow-y-auto flex flex-col gap-3 bg-transparent text-xs sm:text-sm font-sans font-normal"></div>
            
            <!-- Typing Indicator -->
            <div id="typing-indicator" class="hidden px-4 pb-2">
                <div class="border border-theme rounded-sm p-2 inline-block bg-brand-light">
                    <svg height="10" width="30">
                        <circle class="typing-dot" cx="5" cy="5" r="3" />
                        <circle class="typing-dot" cx="15" cy="5" r="3" />
                        <circle class="typing-dot" cx="25" cy="5" r="3" />
                    </svg>
                </div>
            </div>

            <!-- Diverse Topic Pills -->
            <div id="chat-options" class="px-4 py-3 border-t border-theme flex flex-wrap gap-1.5 items-center bg-brand-paper max-h-36 overflow-y-auto"></div>

            <!-- Interactive Free-Text Input Bar -->
            <form onsubmit="handleCustomChatSubmit(event)" class="p-2.5 border-t border-theme bg-brand-light/40 flex gap-2">
                <input id="chat-custom-input" type="text" placeholder="Ask about AI training, rates, Python, Urdu..." class="flex-grow bg-brand-paper border border-theme rounded-sm px-3 py-1.5 text-xs text-brand-ink focus:outline-none">
                <button type="submit" class="border border-brand-ink bg-brand-ink text-brand-paper px-3 py-1.5 rounded-sm text-xs uppercase tracking-wider hover:bg-transparent hover:text-brand-ink transition-colors" data-ui="chat_send">
                    Ask
                </button>
            </form>
        </div>
        
        <!-- Chat Toggle Button -->
        <button id="chat-toggle" onclick="toggleChat()" class="w-14 h-14 bg-brand-light border border-theme rounded-sm flex items-center justify-center text-brand-ink text-xl hover:bg-brand-ink hover:text-brand-paper transition-colors relative group shadow-md" aria-label="Open Virtual Assistant">
            <i class="far fa-comment-dots group-hover:hidden"></i>
            <i class="fas fa-times hidden group-hover:block"></i>
        </button>
    </div>

    <script>
        let currentLang = 'en';
        let inlineEditActive = false;
        let ownerAuthenticated = false;
        let pendingBlogImageData = '';

        // --- 1. Typewriter Effect (Synced across EN & HI) ---
        const phrases = ["Poet.", "AI Trainer.", "Localization Expert."];
        let type_i = 0, type_j = 0, isDeleting = false;
        const speed = 100, pause = 1500;
        
        function typeWriter() {
            const el = document.getElementById("typewriter");
            if (!el) return;
            
            if (type_i >= phrases.length) type_i = 0;
            const currentPhrase = phrases[type_i];
            
            if (isDeleting) {
                el.innerHTML = currentPhrase.substring(0, type_j - 1) + "<span class='font-light'>|</span>";
                type_j--;
                if (type_j === 0) {
                    isDeleting = false;
                    type_i = (type_i + 1) % phrases.length;
                    setTimeout(typeWriter, 500);
                    return;
                }
            } else {
                el.innerHTML = currentPhrase.substring(0, type_j + 1) + "<span class='font-light'>|</span>";
                type_j++;
                if (type_j === currentPhrase.length) {
                    isDeleting = true;
                    setTimeout(typeWriter, pause);
                    return;
                }
            }
            setTimeout(typeWriter, isDeleting ? speed / 2 : speed);
        }

        // --- 2. UI-Only Bilingual Dictionary (Every button and label is customizable by Owner) ---
        const uiDictionary = {
