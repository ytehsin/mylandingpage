                blog_back_home: "मुख्य पृष्ठ पर वापस जाएं",
                btn_new_blog: "+ नया ब्लॉग प्रकाशित करें",
                sec_blog: "अंतर्दृष्टि (Insights)",
                blog_read_cta: "लेख पढ़ें",
                modal_discuss_li: "LinkedIn पर चर्चा करें ↗",
                modal_read_li: "LinkedIn पर पूरा लेख पढ़ें ↗",
                btn_close: "बंद करें",
                btn_print: "प्रिंट / PDF",
                pilot_sub: "प्रोजेक्ट और कोटेशन फ़ॉर्म",
                pilot_title: "पायलट प्रोजेक्ट या कस्टम कोटेशन",
                pilot_desc: "ईमेल या व्हाट्सएप के माध्यम से प्रोजेक्ट विवरण भेजने के लिए नीचे विकल्प चुनें।",
                pilot_lbl1: "1. प्रमुख सेवा चुनें",
                pilot_lbl2: "2. भाषा युग्म (Language Pair)",
                pilot_lbl3: "3. प्रोजेक्ट प्रकार",
                pilot_lbl4: "4. प्रोजेक्ट विवरण / शब्द संख्या / समय-सीमा",
                btn_send_wa: "व्हाट्सएप पर भेजें",
                btn_send_brief: "ईमेल द्वारा भेजें",
                chat_title: "वर्चुअल असिस्टेंट",
                chat_subtitle: "AI ट्रेनिंग • लोकलाइज़ेशन • शायरी • कोटेशन",
                chat_send: "पूछें"
            }
        };

        // --- STREAMING_CHUNK:Defining default CMS data for Case Studies, Clients, Testimonials, Books, and Blogs... ---
        const defaultSiteData = {
            caseStudies: [
                {
                    id: "port1",
                    tag: "Workflow Automation",
                    icon: "fab fa-python",
                    title: "Automating Glossary Updates with Python",
                    desc: "When a client provided a new 700-term glossary a day before a 7,000-word banking localization deadline, manual updates were unfeasible. I wrote a Python script to compare the glossaries, isolate the 73 changed terms, and automatically update 111 instances across the main file in 30 minutes.",
                    body: `<p><strong>The Challenge:</strong> Less than 24 hours before a 7,000-word banking localization deadline, the client delivered an updated 700-term glossary without highlighting what had changed.</p><p><strong>The Technical Solution:</strong> Instead of manually cross-referencing 700 rows, I wrote a Python script using Pandas and regex to diff the old and new glossaries, isolating <strong>73 modified terms</strong>.</p><p><strong>The Result:</strong> The script automatically located and updated <strong>111 term instances</strong> across the target manuscript in under 30 minutes—guaranteeing 100% terminology compliance and on-time delivery.</p>`
                },
                {
                    id: "port2",
                    tag: "Creative Translation",
                    icon: "fas fa-film",
                    title: "Chinese Micro-Drama Hindi Dubbing Adaptation",
                    desc: "Adapted English subtitles of a Chinese micro-drama into natural Hindi for dubbing. By carefully matching the Hindi dialogue to the original actors' emotions, pauses, and lip movements, the voice actors were able to record the script in record time with a highly natural delivery.",
                    body: `<p><strong>The Challenge:</strong> Direct subtitle translations fail in voice dubbing because syllable counts, sentence structure, and emotional beats differ drastically between English/Chinese and Hindi.</p><p><strong>The Linguistic Solution:</strong> Transcreated the script into colloquial, spoken Hindi tailored for lip-sync, matching open/closed vowel movements, dramatic pauses, and character archetypes.</p><p><strong>The Result:</strong> Voice actors recorded the entire micro-drama series in record studio time without needing on-the-fly script rewrites.</p>`
                },
                {
                    id: "port3",
                    tag: "AI LQA & Evaluation",
                    icon: "fas fa-robot",
                    title: "Multilingual LLM Evaluation & Orthographic LQA",
                    desc: "Audited Hindi and Urdu outputs across major AI models (ChatGPT, Claude, Gemini) for semantic accuracy, instruction compliance, cultural register, and Devanagari orthography (Nuqta & Chandrabindu), establishing rigorous human-in-the-loop QA standards for AI training datasets.",
                    body: `<p><strong>The Challenge:</strong> Frontier LLMs (ChatGPT, Claude, Gemini) frequently struggle with South Asian cultural register, literal translationese, factual hallucinations, and Devanagari orthographic precision such as <em>nuqtas</em> (ज़, फ़, ख़) and <em>chandrabindu</em> (ँ).</p><p><strong>The Diagnostic Analysis:</strong> Conducted comparative model evaluations demonstrating how uncurated web-scraped datasets propagate semantic drift and orthographic inconsistency into model weights.</p><p><strong>The Takeaway:</strong> Effective South Asian AI training and LLM alignment require human-in-the-loop (HITL) linguists who enforce comprehensive semantic, cultural, and orthographic rubrics during SFT and RLHF stages.</p>`
                }
            ],
            clients: [
                { id: "c1", name: "FidelTech", sub: "Fidel Softech • Localization & Tech" },
                { id: "c2", name: "MoEFCC", sub: "Ministry of Environment, Forest & Climate Change" },
                { id: "c3", name: "Riverie", sub: "Indic Language Localization" },
                { id: "c4", name: "PPH", sub: "Productive Playhouse • AI Data & Localization" }
            ],
            testimonials: [
                {
                    id: "t1",
                    quote: "Yasir combines deep native mastery of Hindi and Urdu with rare technical problem-solving. When last-minute terminology changes threatened a major banking localization delivery, his Python automation and LQA kept the entire project on schedule with zero errors.",
                    author: "Localization Project Manager",
                    org: "Enterprise Language & Tech Partner"
                },
                {
                    id: "t2",
                    quote: "As an AI Trainer and linguistic evaluator, Yasir brings an exceptional eye for detail. His audits of Hindi and Urdu LLM outputs consistently catch subtle semantic, cultural, and orthographic nuances that standard QA pipelines miss.",
                    author: "AI Training & LQA Lead",
                    org: "Multilingual AI & Data Team"
                },
                {
                    id: "t3",
                    quote: "Working with Yasir on creative Hindi adaptation and dubbing scripts was effortless. Because of his literary background, his translations never sound robotic—they capture the exact emotion, rhythm, and natural spoken flow of the characters.",
                    author: "Creative Content & Dubbing Lead",
                    org: "Media & Localization Production"
                }
            ],
            publicationsVisible: false,
            publications: [],
            blogs: [
                {
                    id: "blog1",
                    category: "AI & Business",
                    date: "May 2025",
                    title: "David's New Sling: How AI Is Powering The Rise of Small",
                    desc: "Exploring how Artificial Intelligence acts as a great equalizer, empowering small businesses and freelancers to compete with larger entities by automating complex workflows and scaling operations efficiently.",
                    link: "https://www.linkedin.com/pulse/davids-new-sling-how-ai-powering-rise-small-yasir-tehsin-i3v9c/",
                    image: "",
                    body: `<p>For decades, scale was the ultimate moat. Large enterprises dominated localization, software, and operations simply because they could coordinate hundreds of specialists across rigid pipelines.</p><p>Today, Artificial Intelligence and lightweight scripting act as David's new sling. An independent specialist armed with domain mastery, Python automation, and well-trained AI workflows can audit, transcreate, and deploy high-volume assets at a speed and consistency that used to require an entire department.</p><p>The future belongs not to unguided automation, nor to manual repetition—but to agile human-in-the-loop experts who combine deep craft with algorithmic leverage.</p>`
                },
                {
                    id: "blog2",
                    category: "AI & Art",
                    date: "Apr 2025",
                    title: "Ghiblification: Art, AI, and the Soulless Imitation",
                    desc: "A critical look at how AI generation impacts artistic integrity, specifically examining the trend of 'Ghiblification' and whether algorithmic imitation can capture the true essence of human creativity and emotion.",
                    link: "https://www.linkedin.com/pulse/ghiblification-art-ai-soulless-imitation-yasir-tehsin-5jkvc/",
                    image: "",
                    body: `<p>When viral filters reduce decades of hand-drawn Miyazaki craftsmanship into a one-click aesthetic, we witness both the triumph of statistical pattern matching and the erosion of artistic intent.</p><p>The same phenomenon happens in literature and translation: an LLM can mimic the surface cadence of Hindi or Urdu prose, yet completely miss the lived cultural subtext, silence, and emotional weight behind a single chosen word.</p><p>True art—and true literary transcreation—is not merely style transfer; it is human intention made visible.</p>`
                },
                {
                    id: "blog3",
                    category: "Linguistics & AI",
                    date: "Mar 2025",
                    title: "Beyond Tokenization: Why LLMs Need Human-in-the-Loop Cultural & Orthographic Alignment",
                    desc: "An examination of why large language models struggle with South Asian semantic nuance, register, and Devanagari diacritics, and how expert AI training bridges the gap in RLHF pipelines.",
                    link: "https://www.linkedin.com/in/yasirtehsin/recent-activity/articles/",
                    image: "",
                    body: `<p>In Hindi and Urdu localization, both macro-level cultural register and micro-level orthography determine whether an AI response builds trust or breaks it. Frontier LLMs routinely struggle with domain-specific idioms, factual grounding in regional contexts, and diacritics that shift meaning (such as <em>Jara</em> vs. <em>Zara</em>).</p><p>Because web-scraped training corpora contain noisy, unstandardized text, models internalize inconsistent patterns. Fixing this requires curated SFT datasets, multi-dimensional evaluation rubrics, and expert AI trainers who understand both computational tokenization and literary craft.</p>`
                }
            ],
            customSections: [],
            inlineEdits: {},
            uiOverrides: { en: {}, hi: {} },
            ownerPasscode: "yasir2026"
        };

        let siteData = JSON.parse(JSON.stringify(defaultSiteData));

        // --- STREAMING_CHUNK:Implementing Owner-Only authentication and state persistence... ---
        function loadSiteData() {
            try {
                const saved = localStorage.getItem('yasir_site_cms_v2');
                if (saved) {
                    const parsed = JSON.parse(saved);
                    siteData = Object.assign(JSON.parse(JSON.stringify(defaultSiteData)), parsed);
                }
                if (siteData.uiOverrides) {
                    if (siteData.uiOverrides.en) Object.assign(uiDictionary.en, siteData.uiOverrides.en);
                    if (siteData.uiOverrides.hi) Object.assign(uiDictionary.hi, siteData.uiOverrides.hi);
                }
                if (sessionStorage.getItem('yasir_owner_unlocked') === 'true') {
                    ownerAuthenticated = true;
                    document.body.classList.add('owner-authenticated');
                }
            } catch (e) {
                console.warn('Could not load saved CMS state:', e);
            }
        }

        function persistSiteData() {
            try {
                localStorage.setItem('yasir_site_cms_v2', JSON.stringify(siteData));
            } catch (e) {
                console.warn('Could not persist CMS state:', e);
            }
            syncBlogSchemaGraph();
        }

        function handleOwnerTrigger() {
            if (ownerAuthenticated) {
                openStudioDrawer('blog');
            } else {
                openOwnerAuthModal();
            }
        }

        function openOwnerAuthModal() {
            const modal = document.getElementById('owner-auth-modal');
            const err = document.getElementById('owner-auth-error');
            const input = document.getElementById('owner-auth-pass');
            if (err) err.classList.add('hidden');
            if (input) input.value = '';
            toggleModalPasswordChange(false);
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => input && input.focus(), 50);
        }

        function closeOwnerAuthModal() {
            const modal = document.getElementById('owner-auth-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function toggleModalPasswordChange(showChangeForm) {
            const loginForm = document.getElementById('owner-login-form');
            const changeForm = document.getElementById('owner-change-pw-form');
            const feedback = document.getElementById('modal-pw-feedback');
            if (feedback) feedback.classList.add('hidden');
            if (showChangeForm) {
                loginForm?.classList.add('hidden');
                changeForm?.classList.remove('hidden');
                document.getElementById('modal-current-pass').value = '';
                document.getElementById('modal-new-pass').value = '';
                document.getElementById('modal-confirm-pass').value = '';
            } else {
                changeForm?.classList.add('hidden');
                loginForm?.classList.remove('hidden');
            }
        }

        function verifyOwnerPasscode(e) {
            e.preventDefault();
            const input = document.getElementById('owner-auth-pass');
            const entered = (input?.value || '').trim();
            const expected = siteData.ownerPasscode || 'yasir2026';
            if (entered === expected) {
                ownerAuthenticated = true;
                sessionStorage.setItem('yasir_owner_unlocked', 'true');
                document.body.classList.add('owner-authenticated');
                closeOwnerAuthModal();
                openStudioDrawer('blog');
            } else {
                const err = document.getElementById('owner-auth-error');
                if (err) err.classList.remove('hidden');
            }
        }

        function handleModalPasswordChange(e) {
            e.preventDefault();
            const cur = (document.getElementById('modal-current-pass')?.value || '').trim();
            const nw = (document.getElementById('modal-new-pass')?.value || '').trim();
            const cf = (document.getElementById('modal-confirm-pass')?.value || '').trim();
            const feedback = document.getElementById('modal-pw-feedback');
            const expected = siteData.ownerPasscode || 'yasir2026';

            if (!feedback) return;
            feedback.classList.remove('hidden');

            if (cur !== expected) {
                feedback.className = 'text-xs text-red-600';
                feedback.innerText = 'Current password is incorrect.';
                return;
            }
            if (!nw || nw.length < 4) {
                feedback.className = 'text-xs text-red-600';
                feedback.innerText = 'New password must be at least 4 characters.';
                return;
            }
            if (nw !== cf) {
                feedback.className = 'text-xs text-red-600';
                feedback.innerText = 'New passwords do not match.';
                return;
            }

            siteData.ownerPasscode = nw;
            persistSiteData();
            ownerAuthenticated = true;
            sessionStorage.setItem('yasir_owner_unlocked', 'true');
            document.body.classList.add('owner-authenticated');
            closeOwnerAuthModal();
            openStudioDrawer('ui');
        }

        function updateOwnerPasscode() {
            const cur = (document.getElementById('cms-current-pass')?.value || '').trim();
            const nw = (document.getElementById('cms-new-pass')?.value || '').trim();
            const cf = (document.getElementById('cms-confirm-pass')?.value || '').trim();
            const feedback = document.getElementById('cms-pass-feedback');
            const expected = siteData.ownerPasscode || 'yasir2026';

            if (!feedback) return;
            feedback.classList.remove('hidden');

            if (cur !== expected) {
                feedback.className = 'text-xs text-red-600';
                feedback.innerText = 'Current password is incorrect.';
                return;
            }
            if (!nw || nw.length < 4) {
                feedback.className = 'text-xs text-red-600';
                feedback.innerText = 'New password must be at least 4 characters.';
                return;
            }
            if (nw !== cf) {
                feedback.className = 'text-xs text-red-600';
                feedback.innerText = 'New passwords do not match.';
                return;
            }

            siteData.ownerPasscode = nw;
            persistSiteData();
            document.getElementById('cms-current-pass').value = '';
            document.getElementById('cms-new-pass').value = '';
            document.getElementById('cms-confirm-pass').value = '';
            feedback.className = 'text-xs text-green-700 font-bold';
            feedback.innerText = 'Password updated! Click "Download Updated HTML" at the top of this window to permanently bake the new password into your file.';
        }

        function lockOwnerSession() {
            if (inlineEditActive) toggleInlineEditMode();
            ownerAuthenticated = false;
            sessionStorage.removeItem('yasir_owner_unlocked');
            document.body.classList.remove('owner-authenticated');
            closeStudioDrawer();
        }

        // --- STREAMING_CHUNK:Rendering dynamic grids for Case Studies, Clients, Testimonials, Publications, and Blogs... ---
        function renderCaseStudies() {
            const grid = document.getElementById('case-studies-grid');
            if (!grid) return;
            const ctaText = uiDictionary[currentLang].port_cta;
            grid.innerHTML = siteData.caseStudies.map(cs => `
                <div class="border border-theme rounded-sm flex flex-col group cursor-pointer hover:bg-brand-light transition-colors relative" onclick="if(!inlineEditActive) openCaseStudy('${cs.id}')">
                    <div class="p-8 border-b border-theme flex justify-between items-center">
                        <span class="text-xs uppercase tracking-widest text-brand-secondary">${cs.tag}</span>
                        <i class="${cs.icon || 'fas fa-layer-group'} text-2xl text-brand-ink"></i>
                    </div>
                    <div class="p-8 flex-grow flex flex-col">
                        <h3 class="text-xl font-serif text-brand-ink mb-4 font-normal">${cs.title}</h3>
                        <p class="text-sm text-brand-secondary mb-6 flex-grow leading-relaxed font-normal">${cs.desc}</p>
                        <span class="text-brand-ink text-xs uppercase tracking-widest border-b border-brand-ink self-start pb-1 group-hover:pl-2 transition-all" data-ui="port_cta">${ctaText}</span>
                    </div>
                </div>
            `).join('');
        }

        function renderClientsAndTestimonials() {
            const clientsGrid = document.getElementById('clients-grid');
            if (clientsGrid) {
                clientsGrid.innerHTML = siteData.clients.map((c, idx) => `
                    <div class="p-8 ${idx < siteData.clients.length - 1 ? 'border-b md:border-b-0 border-r' : ''} border-theme flex flex-col items-center justify-center text-center hover:bg-brand-light transition-colors min-h-[8rem]">
                        <span class="font-serif text-xl text-brand-ink tracking-wide mb-1" data-editable="true">${c.name}</span>
                        <span class="text-xs uppercase tracking-widest text-brand-secondary" data-editable="true">${c.sub}</span>
                    </div>
                `).join('');
            }

            const testGrid = document.getElementById('testimonials-grid');
            if (testGrid) {
                testGrid.innerHTML = siteData.testimonials.map(t => `
                    <div class="border border-theme rounded-sm p-8 flex flex-col justify-between hover:bg-brand-light transition-colors">
                        <div>
                            <div class="flex justify-end items-center text-brand-secondary text-xs uppercase tracking-widest mb-4">
                                <i class="fas fa-quote-right"></i>
                            </div>
                            <p class="text-sm text-brand-ink leading-relaxed mb-6 font-normal" data-editable="true">"${t.quote.replace(/^"|"$/g, '')}"</p>
                        </div>
                        <div class="border-t border-theme pt-4 flex justify-between items-end">
                            <div>
                                <div class="text-sm font-serif text-brand-ink" data-editable="true">${t.author}</div>
                                <div class="text-xs uppercase tracking-widest text-brand-secondary mt-1" data-editable="true">${t.org}</div>
                            </div>
                        </div>
                    </div>
                `).join('');
