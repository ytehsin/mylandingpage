            }
        }

        function formatParagraphsToHTML(rawText) {
            if (!rawText) return '';
            if (rawText.includes('<p>')) return rawText;
            return rawText
                .split(/\n\s*\n/)
                .map(p => `<p>${p.trim().replace(/\n/g, '<br>')}</p>`)
                .join('');
        }

        function stripHTMLToPlainText(html) {
            if (!html) return '';
            return html.replace(/<\/p>\s*<p>/gi, '\n\n').replace(/<\/?p>/gi, '').trim();
        }

        // Blog Image Upload & URL Preview
        function previewBlogImageUrl(url) {
            const val = (url || '').trim();
            const wrap = document.getElementById('new-blog-img-preview-wrap');
            const img = document.getElementById('new-blog-img-preview');
            pendingBlogImageData = val;
            if (val && wrap && img) {
                img.src = val;
                wrap.classList.remove('hidden');
            } else if (wrap) {
                wrap.classList.add('hidden');
            }
        }

        function handleBlogImageUpload(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const imgObj = new Image();
                imgObj.onload = function() {
                    const canvas = document.createElement('canvas');
                    const maxW = 900;
                    const scale = imgObj.width > maxW ? (maxW / imgObj.width) : 1;
                    canvas.width = Math.round(imgObj.width * scale);
                    canvas.height = Math.round(imgObj.height * scale);
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(imgObj, 0, 0, canvas.width, canvas.height);
                    const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.82);
                    pendingBlogImageData = compressedDataUrl;
                    const urlInput = document.getElementById('new-blog-img-url');
                    if (urlInput) urlInput.value = '[Uploaded Image Ready]';
                    const wrap = document.getElementById('new-blog-img-preview-wrap');
                    const previewImg = document.getElementById('new-blog-img-preview');
                    if (wrap && previewImg) {
                        previewImg.src = compressedDataUrl;
                        wrap.classList.remove('hidden');
                    }
                };
                imgObj.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function clearBlogImageInput() {
            pendingBlogImageData = '';
            const urlInput = document.getElementById('new-blog-img-url');
            const fileInput = document.getElementById('new-blog-img-file');
            const wrap = document.getElementById('new-blog-img-preview-wrap');
            if (urlInput) urlInput.value = '';
            if (fileInput) fileInput.value = '';
            if (wrap) wrap.classList.add('hidden');
        }

        function saveBlogPost() {
            const idField = document.getElementById('edit-blog-id').value;
            const cat = document.getElementById('new-blog-cat').value.trim() || 'Insights';
            const date = document.getElementById('new-blog-date').value.trim() || 'Oct 2026';
            const link = document.getElementById('new-blog-link').value.trim() || 'https://www.linkedin.com/in/yasirtehsin/recent-activity/articles/';
            const title = document.getElementById('new-blog-title').value.trim();
            const desc = document.getElementById('new-blog-desc').value.trim();
            const bodyRaw = document.getElementById('new-blog-body').value.trim();
            const urlInputVal = document.getElementById('new-blog-img-url').value.trim();
            const image = (urlInputVal && urlInputVal !== '[Uploaded Image Ready]') ? urlInputVal : pendingBlogImageData;

            if (!title || !desc) return;

            const formattedBody = formatParagraphsToHTML(bodyRaw || desc);

            if (idField) {
                const idx = siteData.blogs.findIndex(b => b.id === idField);
                if (idx > -1) {
                    siteData.blogs[idx] = { id: idField, category: cat, date, title, desc, link, image: image || '', body: formattedBody };
                }
            } else {
                const newId = 'blog_' + Date.now();
                siteData.blogs.unshift({ id: newId, category: cat, date, title, desc, link, image: image || '', body: formattedBody });
            }

            persistSiteData();
            renderBlogs();
            renderStudioLists();
            resetBlogForm();
            openBlogView();
            closeStudioDrawer();
        }

        function populateBlogForm(id) {
            const post = siteData.blogs.find(b => b.id === id);
            if (!post) return;
            document.getElementById('edit-blog-id').value = post.id;
            document.getElementById('new-blog-cat').value = post.category;
            document.getElementById('new-blog-date').value = post.date;
            document.getElementById('new-blog-link').value = post.link || '';
            document.getElementById('new-blog-title').value = post.title;
            document.getElementById('new-blog-desc').value = post.desc;
            document.getElementById('new-blog-body').value = stripHTMLToPlainText(post.body);
            pendingBlogImageData = post.image || '';
            const urlInput = document.getElementById('new-blog-img-url');
            const wrap = document.getElementById('new-blog-img-preview-wrap');
            const previewImg = document.getElementById('new-blog-img-preview');
            if (post.image) {
                if (urlInput) urlInput.value = post.image.startsWith('data:') ? '[Uploaded Image Ready]' : post.image;
                if (wrap && previewImg) {
                    previewImg.src = post.image;
                    wrap.classList.remove('hidden');
                }
            } else {
                clearBlogImageInput();
            }
            document.getElementById('blog-form-heading').innerText = `Editing: ${post.title}`;
        }

