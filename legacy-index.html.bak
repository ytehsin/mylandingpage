        function renderPublications() {
            const sec = document.getElementById('publications-section');
            const grid = document.getElementById('publications-grid');
            const badge = document.getElementById('pub-visibility-badge');
            const toggleBtn = document.getElementById('pub-toggle-btn');
            if (!sec || !grid) return;

            const shouldShowPublic = siteData.publicationsVisible && siteData.publications.length > 0;
            if (shouldShowPublic || inlineEditActive) {
                sec.classList.remove('hidden');
            } else {
                sec.classList.add('hidden');
            }

            if (badge) {
                badge.innerText = shouldShowPublic ? 'Visible to Public' : 'Hidden from Public (Empty / Draft)';
            }
            if (toggleBtn) {
                toggleBtn.innerText = siteData.publicationsVisible ? 'Public Visibility: ON' : 'Public Visibility: OFF';
                toggleBtn.className = siteData.publicationsVisible
                    ? 'border border-brand-ink bg-brand-ink text-brand-paper px-4 py-2 text-xs uppercase tracking-wider rounded-sm transition-colors whitespace-nowrap'
                    : 'border border-brand-ink px-4 py-2 text-xs uppercase tracking-wider rounded-sm hover:bg-brand-ink hover:text-brand-paper transition-colors whitespace-nowrap';
            }

            if (siteData.publications.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full border border-dashed border-theme p-8 text-center text-xs uppercase tracking-widest text-brand-secondary">
                        No books published yet. Click "Manage Publications" to add your books and toggle public visibility.
                    </div>
                `;
            } else {
                grid.innerHTML = siteData.publications.map(pub => `
                    <div class="border border-theme rounded-sm p-8 flex flex-col justify-between hover:bg-brand-light transition-colors">
                        <div>
                            <div class="flex justify-between items-center text-xs uppercase tracking-widest text-brand-secondary mb-3">
                                <span>${pub.meta}</span>
                                <i class="fas fa-book-open text-brand-ink"></i>
                            </div>
                            <h3 class="text-xl font-serif text-brand-ink mb-3 font-normal">${pub.title}</h3>
                            <p class="text-sm text-brand-secondary leading-relaxed mb-6">${pub.desc}</p>
                        </div>
                        ${pub.link ? `<a href="${pub.link}" target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-widest text-brand-ink border-b border-brand-ink self-start pb-1">View Publication ↗</a>` : ''}
                    </div>
                `).join('');
            }
        }

        function renderBlogs() {
            const grid = document.getElementById('blog-posts-grid');
            const badge = document.getElementById('blog-count-badge');
            if (!grid) return;
            const ctaText = uiDictionary[currentLang].blog_read_cta;
            if (badge) {
                badge.innerText = `${siteData.blogs.length} Published ${siteData.blogs.length === 1 ? 'Article' : 'Articles'}`;
            }
            grid.innerHTML = siteData.blogs.map(post => `
                <article class="group cursor-pointer border border-theme rounded-sm overflow-hidden hover:bg-brand-light transition-colors flex flex-col justify-between relative" onclick="if(!inlineEditActive) openBlogModal('${post.id}')">
                    <div>
                        ${post.image ? `
                        <div class="w-full h-48 border-b border-theme overflow-hidden bg-brand-light/30">
                            <img src="${post.image}" alt="${post.title}" class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300">
                        </div>` : ''}
                        <div class="p-8 pb-0">
