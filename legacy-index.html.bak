                <button onclick="if(!inlineEditActive) { navigateHomeSection('contact'); document.getElementById('mobile-menu').classList.add('hidden'); }" class="block w-full text-left px-3 py-3 text-sm text-brand-ink border-b border-theme uppercase tracking-wider" data-ui="nav_contact">Contact</button>
                <div class="flex items-center space-x-2 px-3 py-4">
                    <button onclick="setLanguage('en')" class="text-sm border border-theme px-3 py-1 rounded-sm" data-ui="btn_lang_en">EN</button>
