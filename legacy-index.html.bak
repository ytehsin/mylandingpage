    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['var(--font-body)', 'sans-serif'],
                        serif: ['var(--font-heading)', 'serif'],
                    },
                    colors: {
                        brand: {
                            paper: 'var(--c-paper)',
                            ink: 'var(--c-ink)',
                            primary: 'var(--c-primary)',
                            secondary: 'var(--c-secondary)',
                            light: 'var(--c-light)',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            /* ENGLISH THEME: Ultra-calm, minimal, grayscale typewriter */
            --c-paper: #FAFAFA; 
            --c-ink: #1A1A1A; 
            --c-primary: #333333; 
            --c-secondary: #666666; 
            --c-light: #EEEEEE;
            --font-heading: 'Courier Prime', monospace;
            --font-body: 'Courier Prime', monospace;
            --bg-pattern: none;
            --nav-bg: rgba(250, 250, 250, 0.95);
            --border-color: #E5E5E5;
        }

        body.theme-hi {
            /* HINDI THEME: Traditional, Warm, Cultural */
            --c-paper: #FFF9EC; 
            --c-ink: #3E2723; 
            --c-primary: #C0392B; 
            --c-secondary: #D35400; 
            --c-light: #FFECD2;
            --font-heading: 'Yatra One', serif;
            --font-body: 'Noto Serif Devanagari', serif;
            --bg-pattern: url("data:image/svg+xml,%3Csvg width='20' height='20' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='2' cy='2' r='2' fill='%23b22222' fill-opacity='0.05'/%3E%3C/svg%3E");
            --nav-bg: rgba(255, 249, 236, 0.95);
            --border-color: #EEDCC6;
        }

        body {
            background-color: var(--c-paper);
            color: var(--c-ink);
            overflow-x: hidden;
            transition: background-color 0.4s ease, color 0.4s ease;
            font-feature-settings: "kern" 1, "liga" 1;
        }
        
        .bg-texture {
            background-image: var(--bg-pattern);
            transition: background-image 0.4s ease;
        }

        .nav-glass {
            background-color: var(--nav-bg);
            transition: background-color 0.4s ease;
        }
        
        .border-theme {
            border-color: var(--border-color);
            transition: border-color 0.4s ease;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--c-paper); }
        ::-webkit-scrollbar-thumb { background: var(--c-secondary); }
        
        .typing-dot {
            animation: typing 1.4s infinite ease-in-out;
            fill: var(--c-primary);
        }
        .typing-dot:nth-child(1) { animation-delay: 0s; }
        .typing-dot:nth-child(2) { animation-delay: 0.2s; }
        .typing-dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes typing {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }

        /* Language Toggle Switch */
        .lang-switch-active {
            background-color: var(--c-primary);
            color: var(--c-paper);
        }
        .lang-switch-inactive {
            color: var(--c-secondary);
        }
        .lang-switch-inactive:hover {
            color: var(--c-ink);
        }

        /* Studio Inline Edit Mode Highlights (Owner Only) */
        body.studio-edit-active [data-editable="true"],
        body.studio-edit-active [data-ui] {
            outline: 1px dashed var(--c-secondary);
            outline-offset: 4px;
            cursor: text !important;
            transition: outline-color 0.2s ease, background-color 0.2s ease;
        }
        body.studio-edit-active [data-editable="true"]:focus,
        body.studio-edit-active [data-ui]:focus {
            outline: 2px solid var(--c-ink);
            background-color: var(--c-light);
        }
        .studio-only,
        .owner-only {
            display: none !important;
        }
        body.studio-edit-active .studio-only {
            display: inline-flex !important;
        }
        body.owner-authenticated .owner-only {
            display: inline-flex !important;
        }

        @media print {
            nav, footer, #chatbot-container, #home-view, #blog-view, #studio-bar, #studio-drawer, #owner-auth-modal { display: none !important; }
            #resume-modal { position: static !important; display: block !important; background: white !important; padding: 0 !important; }
            #resume-modal-content { max-height: none !important; overflow: visible !important; border: none !important; box-shadow: none !important; width: 100% !important; max-width: 100% !important; }
            .no-print { display: none !important; }
        }
    </style>
</head>
