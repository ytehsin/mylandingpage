        function renderCustomSections() {
            const container = document.getElementById('custom-sections-container');
            if (!container) return;
            container.innerHTML = (siteData.customSections || []).map(sec => {
                const cards = (sec.content || '').split(/\n---\n/).map(item => {
                    const parts = item.split(':');
                    const cardTitle = parts.length > 1 ? parts.shift().trim() : '';
                    const cardBody = parts.join(':').trim();
                    return `
                        <div class="border border-theme rounded-sm p-8 hover:bg-brand-light transition-colors">
                            ${cardTitle ? `<h3 class="text-lg font-serif text-brand-ink mb-3 font-normal" data-editable="true">${cardTitle}</h3>` : ''}
                            <p class="text-sm text-brand-secondary leading-relaxed" data-editable="true">${cardBody}</p>
                        </div>
                    `;
                }).join('');
                return `
                    <section id="${sec.id}" class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-theme">
                        <div class="mb-12 flex justify-between items-end">
                            <div>
                                <span class="text-brand-secondary tracking-widest text-xs uppercase mb-2 block" data-editable="true">${sec.sub}</span>
                                <h2 class="text-3xl font-serif text-brand-ink font-normal" data-editable="true">${sec.title}</h2>
                            </div>
                            <button onclick="deleteCustomSection('${sec.id}')" class="owner-only text-xs uppercase tracking-wider border border-theme px-3 py-1 rounded-sm text-brand-secondary hover:text-brand-ink">Remove Section</button>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">${cards}</div>
                    </section>
                `;
            }).join('');
        }

        // Dynamically sync BlogPosting and Book entities into JSON-LD @graph
        function syncBlogSchemaGraph() {
            const schemaEl = document.getElementById('entity-schema-graph');
            if (!schemaEl) return;
            try {
                const data = JSON.parse(schemaEl.textContent);
                if (Array.isArray(data['@graph'])) {
                    data['@graph'] = data['@graph'].filter(node => node['@type'] !== 'BlogPosting' && node['@type'] !== 'Book');
                    siteData.blogs.forEach(post => {
                        data['@graph'].push({
                            "@type": "BlogPosting",
                            "@id": `https://yasirtehsin.com/#${post.id}`,
                            "headline": post.title,
                            "description": post.desc,
                            "articleSection": post.category,
                            ...(post.image && !post.image.startsWith('data:') ? { "image": post.image } : {}),
                            "author": { "@id": "https://yasirtehsin.com/#person" },
                            "publisher": { "@id": "https://yasirtehsin.com/#organization" },
                            "url": post.link || "https://yasirtehsin.com/#blog"
                        });
                    });
                    if (siteData.publicationsVisible) {
                        siteData.publications.forEach(pub => {
                            data['@graph'].push({
                                "@type": "Book",
                                "@id": `https://yasirtehsin.com/#${pub.id}`,
                                "name": pub.title,
                                "description": pub.desc,
                                "author": { "@id": "https://yasirtehsin.com/#person" },
                                ...(pub.link ? { "url": pub.link } : {})
                            });
                        });
                    }
                    schemaEl.textContent = JSON.stringify(data, null, 2);
                }
            } catch (e) {
                console.warn('Schema sync skipped:', e);
            }
        }

        // --- STREAMING_CHUNK:Implementing view navigation, language switching, and modal handlers... ---
        function openBlogView() {
            document.getElementById('home-view').classList.add('hidden');
            document.getElementById('blog-view').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function navigateHomeSection(sectionId) {
            const blogView = document.getElementById('blog-view');
            const homeView = document.getElementById('home-view');
            if (!blogView.classList.contains('hidden')) {
                blogView.classList.add('hidden');
                homeView.classList.remove('hidden');
            }
            if (sectionId === 'top') {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                const target = document.getElementById(sectionId);
                if (target) {
                    setTimeout(() => {
                        target.scrollIntoView({ behavior: 'smooth' });
                    }, 30);
                }
            }
        }

        function setLanguage(lang) {
            currentLang = lang;
            document.documentElement.lang = lang;
            
            if (lang === 'hi') {
                document.body.classList.add('theme-hi');
            } else {
                document.body.classList.remove('theme-hi');
            }

            document.getElementById('btn-en').className = lang === 'en' 
                ? 'px-3 py-1 text-xs transition-all rounded-sm lang-switch-active' 
                : 'px-3 py-1 text-xs transition-all rounded-sm lang-switch-inactive';
            document.getElementById('btn-hi').className = lang === 'hi' 
                ? 'px-3 py-1 text-xs transition-all rounded-sm lang-switch-active' 
                : 'px-3 py-1 text-xs transition-all rounded-sm lang-switch-inactive';

            document.querySelectorAll('[data-ui]').forEach(el => {
                const key = el.getAttribute('data-ui');
                if (uiDictionary[lang][key]) {
                    el.innerHTML = uiDictionary[lang][key];
                }
            });

            const chatInput = document.getElementById('chat-custom-input');
            if (chatInput) {
                chatInput.placeholder = lang === 'hi'
                    ? 'AI ट्रेनिंग, लोकलाइज़ेशन, Python या कोटेशन के बारे में पूछें...'
                    : 'Ask about AI training, rates, Python, Urdu...';
            }

            resetChatbot(lang);
        }

        function copyEmailAddress() {
            const emailEl = document.getElementById('email-address-text');
            const email = emailEl ? emailEl.innerText.trim() : "yasirtehsin@gmail.com";
            try {
                const tempInput = document.createElement("textarea");
                tempInput.value = email;
                document.body.appendChild(tempInput);
                tempInput.select();
                document.execCommand("copy");
                document.body.removeChild(tempInput);
            } catch (e) {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(email);
                }
            }
            const btnText = document.getElementById('copy-btn-text');
            if (btnText) {
                btnText.innerText = currentLang === 'hi' ? 'कॉपी हो गया!' : 'Copied!';
                setTimeout(() => {
                    btnText.innerText = uiDictionary[currentLang].btn_copy;
                }, 1800);
            }
        }

        function openCaseStudy(id) {
            const data = siteData.caseStudies.find(c => c.id === id);
            if (!data) return;
            document.getElementById('case-modal-tag').innerText = data.tag;
            document.getElementById('case-modal-title').innerText = data.title;
            document.getElementById('case-modal-body').innerHTML = data.body;
            const modal = document.getElementById('case-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeCaseStudy() {
            const modal = document.getElementById('case-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function openBlogModal(id) {
            const data = siteData.blogs.find(b => b.id === id);
            if (!data) return;
            document.getElementById('blog-modal-meta').innerText = `${data.category} • ${data.date} • By Yasir Tehsin`;
            document.getElementById('blog-modal-title').innerText = data.title;
            const imgWrap = document.getElementById('blog-modal-img-wrap');
            const imgEl = document.getElementById('blog-modal-img');
            if (data.image && imgWrap && imgEl) {
                imgEl.src = data.image;
                imgEl.alt = data.title;
                imgWrap.classList.remove('hidden');
            } else if (imgWrap) {
                imgWrap.classList.add('hidden');
            }
            document.getElementById('blog-modal-body').innerHTML = data.body;
            document.getElementById('blog-modal-link').href = data.link || 'https://www.linkedin.com/in/yasirtehsin/recent-activity/articles/';
            const modal = document.getElementById('blog-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeBlogModal() {
            const modal = document.getElementById('blog-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function openResumeModal() {
            const modal = document.getElementById('resume-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeResumeModal() {
            const modal = document.getElementById('resume-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function downloadAttachedResumePDF() {
            if (!window.jspdf || !window.jspdf.jsPDF) {
                window.print();
                return;
            }
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ unit: 'pt', format: 'a4' });
            const pageWidth = doc.internal.pageSize.getWidth();
            const pageHeight = doc.internal.pageSize.getHeight();
            const margin = 44;
            const contentWidth = pageWidth - margin * 2;
            let y = 48;

            function checkPageBreak(needed = 24) {
                if (y + needed > pageHeight - 44) {
                    doc.addPage();
                    y = 48;
                }
            }

            function addSectionHeading(title) {
                checkPageBreak(36);
                y += 8;
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(10.5);
                doc.setTextColor(20, 20, 20);
                doc.text(title.toUpperCase(), margin, y);
                y += 4;
                doc.setDrawColor(80, 80, 80);
                doc.setLineWidth(0.75);
                doc.line(margin, y, pageWidth - margin, y);
                y += 14;
            }

            function addParagraph(text, fontStyle = 'normal', fontSize = 9.5, indent = 0, spacingAfter = 6) {
                doc.setFont('helvetica', fontStyle);
                doc.setFontSize(fontSize);
                doc.setTextColor(30, 30, 30);
                const lines = doc.splitTextToSize(text, contentWidth - indent);
                lines.forEach(line => {
                    checkPageBreak(14);
                    doc.text(line, margin + indent, y);
                    y += 13;
                });
                y += spacingAfter - 6;
            }

            function addSkillLine(label, text) {
                checkPageBreak(18);
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(9.5);
                const labelText = label + ': ';
                const labelWidth = doc.getTextWidth(labelText);
                doc.text(labelText, margin, y);

                doc.setFont('helvetica', 'normal');
                const wrapped = doc.splitTextToSize(text, contentWidth - labelWidth);
                doc.text(wrapped[0], margin + labelWidth, y);
                y += 13;
                for (let i = 1; i < wrapped.length; i++) {
                    checkPageBreak(14);
                    doc.text(wrapped[i], margin, y);
                    y += 13;
                }
                y += 2;
            }

            function addRoleHeader(company, location, role, dates) {
                checkPageBreak(32);
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(10);
                doc.text(company, margin, y);
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(9.5);
                doc.text(location, pageWidth - margin, y, { align: 'right' });
                y += 13;

                doc.setFont('helvetica', 'bolditalic');
                doc.setFontSize(9.5);
                doc.text(role, margin, y);
                doc.setFont('helvetica', 'italic');
                doc.text(dates, pageWidth - margin, y, { align: 'right' });
                y += 14;
            }

            function addBullet(text) {
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(9.5);
                const bulletIndent = 12;
                const lines = doc.splitTextToSize(text, contentWidth - bulletIndent);
                checkPageBreak(lines.length * 13 + 4);
                doc.text('•', margin + 2, y);
                lines.forEach(line => {
                    doc.text(line, margin + bulletIndent, y);
                    y += 13;
                });
                y += 1;
            }

            // Header
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(18);
            doc.text('YASSIR AARAFATH', pageWidth / 2, y, { align: 'center' });
            y += 15;

            doc.setFont('helvetica', 'normal');
            doc.setFontSize(9.5);
            doc.text('New Delhi, India | +91 8368691849 | yasirtehsin@gmail.com', pageWidth / 2, y, { align: 'center' });
            y += 13;
            doc.text('linkedin.com/in/yasirtehsin  |  github.com/ytehsin', pageWidth / 2, y, { align: 'center' });
            y += 10;

            // SUMMARY
            addSectionHeading('Summary');
            addParagraph(
                "Senior English-Hindi language specialist with 5+ years in high-volume localization, linguistic quality assurance (LQA) and transcreation, including three years as lead Hindi linguist on Apple Siri. Designed and implemented a gender-neutral Hindi register for Siri while preserving Apple's brand voice, and now works across AI and LLM workflows - media annotation, model output evaluation and prompt engineering - alongside traditional localization. Trilingual in Hindi, English and Urdu."
            );

            // CORE SKILLS
            addSectionHeading('Core Skills');
            addSkillLine('Localization & Quality', 'Translation, transcreation, linguistic quality assurance, terminology management, style guide development, editing, proofreading, copywriting');
            addSkillLine('CAT & Production Tools', 'SDL Trados, MemoQ, Phrase, Loft 2.0 (transcription), Articulate 360, etc');
            addSkillLine('AI & Data', 'Media annotation and labelling, LLM output evaluation, AI/LLM training dataset preparation, prompt engineering for text and image generation');
            addSkillLine('Technical', 'Python scripting, Pandas, workflow automation');
            addSkillLine('Domains', 'Media, education, finance, e-commerce, technology');
            addSkillLine('Coordination', 'Asana, Slack, vendor and freelancer management, deadline planning');

            // PROFESSIONAL EXPERIENCE
            addSectionHeading('Professional Experience');

            // Fidel Tech
            addRoleHeader('Fidel Tech', 'Pune, Maharashtra / India', 'Senior Hindi Expert', 'April 2022 - Present');
            addParagraph('Lead Hindi linguist on Apple accounts, covering Siri, Help documentation and software localization, with additional localization work for Reddit. Awarded a Certificate of Appreciation by the Vice President in the first year.', 'normal', 9.5, 0, 8);

            doc.setFont('helvetica', 'bold');
            doc.setFontSize(9.5);
            doc.text('Apple Siri', margin, y);
            y += 13;
            addBullet('Lead the Hindi team at Fideltech, coordinating linguists and delivering high quality translations.');
            addBullet("Designed and implemented a gender-neutral Hindi register for Siri, resolving grammatical gender constraints in verbs and adjectives while preserving Apple's established tone - adopted as the reference style for Hindi voice output.");
            addBullet('Documented tone, register and terminology standards, creating a style framework used across the Hindi team to keep output consistent between contributors.');
            addBullet('Transcreated prompts and responses for the Indian user base, adapting idiom and cultural reference rather than translating literally.');
            addBullet('Partnered with Apple project managers, language leads and engineers to triage localization bugs, including string-level implementation issues in the build, reducing recurring defects across releases.');

            y += 4;
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(9.5);
            doc.text('Apple Help Documentation & Software', margin, y);
            y += 13;
            addBullet("Translated and localized Help documentation in SDL Trados and Client's internal tooling, maintaining an LQA pass rate of 99%.");
            addBullet('Held terminology and formatting consistency across a growing documentation set through repeated OS release cycles.');
            addBullet('Delivered urgent release builds without waiving quality gates.');
            y += 6;

            // Quest Alliance
            addRoleHeader('Quest Alliance', 'Bengaluru, Karnataka / India', 'Project Manager & Reviewer (concurrent contract engagement)', 'June 2023 - April 2024');
            addBullet('Managed 6-7 third-party translators and content creators across 50 digital courses and scripts, owning scheduling, quality sign-off and final delivery.');
            addBullet('Reviewed and corrected translations and assembled course builds in Articulate 360 prior to release.');
            addBullet('Delivered every course within the agreed timeline with no post-release quality escalations.');
            y += 6;

            // BankSathi
            addRoleHeader('BankSathi', 'Bengaluru, Karnataka / India', 'Hindi Expert', 'September 2021 - April 2022');
            addBullet('Built the Hindi version of the company website from scratch and maintained it through ongoing content releases, tailoring copy to Hindi-speaking users rather than mirroring the English source.');
            addBullet('Localized and tested in-app content end to end, catching and correcting errors pre-release so financial guidance read clearly and naturally.');
            addBullet('Translated confidential banking reports, financial statements and legal documents under strict accuracy and confidentiality requirements.');
            y += 6;

            // Study IQ
            addRoleHeader('Study IQ', 'Gurugram, Haryana / India', 'Hindi Expert', 'August 2019 - September 2021');
