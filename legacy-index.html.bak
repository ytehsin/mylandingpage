                    </div>
                    <div class="px-8 pb-8">
                        <span class="text-brand-ink text-xs uppercase tracking-widest border-b border-brand-ink self-start pb-1 group-hover:pl-2 transition-all" data-ui="blog_read_cta">${ctaText}</span>
                    </div>
                </article>
            `).join('');
