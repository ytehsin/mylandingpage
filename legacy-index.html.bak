        // --- STREAMING_CHUNK:Implementing Direct On-Page Inline Editing, Button Editor, and HTML Export... ---
        function toggleInlineEditMode() {
            if (!ownerAuthenticated) {
                openOwnerAuthModal();
                return;
            }
            inlineEditActive = !inlineEditActive;
            const bar = document.getElementById('studio-bar');
            const btn = document.getElementById('inline-edit-toggle-btn');
            if (inlineEditActive) {
                document.body.classList.add('studio-edit-active');
                document.querySelectorAll('[data-editable="true"]').forEach((el, index) => {
                    el.setAttribute('contenteditable', 'true');
                    if (!el.dataset.editKey) {
                        el.dataset.editKey = 'editable_node_' + index;
                    }
                    el.onblur = () => {
                        siteData.inlineEdits = siteData.inlineEdits || {};
                        siteData.inlineEdits[el.dataset.editKey] = el.innerHTML;
                        persistSiteData();
                    };
                });
                document.querySelectorAll('[data-ui]').forEach(el => {
                    el.setAttribute('contenteditable', 'true');
                    el.onblur = () => {
                        const key = el.getAttribute('data-ui');
                        if (!key) return;
                        const newVal = el.innerHTML.trim();
                        uiDictionary[currentLang][key] = newVal;
                        siteData.uiOverrides = siteData.uiOverrides || { en: {}, hi: {} };
                        siteData.uiOverrides[currentLang][key] = newVal;
                        document.querySelectorAll(`[data-ui="${key}"]`).forEach(peer => {
                            if (peer !== el) peer.innerHTML = newVal;
                        });
                        persistSiteData();
                    };
                });
                bar.classList.remove('hidden');
                bar.classList.add('flex');
                if (btn) btn.innerText = 'Disable Inline Editing';
                renderPublications();
                closeStudioDrawer();
            } else {
                document.body.classList.remove('studio-edit-active');
                document.querySelectorAll('[data-editable="true"], [data-ui]').forEach(el => {
                    el.removeAttribute('contenteditable');
                });
                bar.classList.add('hidden');
                bar.classList.remove('flex');
                if (btn) btn.innerText = 'Enable Inline Editing';
                renderPublications();
            }
        }

        function renderButtonLabelsEditor() {
            const container = document.getElementById('studio-button-labels-grid');
            if (!container) return;
            const keys = Object.keys(uiDictionary.en);
            container.innerHTML = keys.map(k => `
                <div class="border border-theme p-2.5 rounded-sm bg-brand-paper space-y-1.5">
                    <span class="text-[10px] uppercase tracking-widest text-brand-secondary block">${k}</span>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-[10px] text-brand-secondary block">EN</label>
                            <input type="text" data-ui-edit-lang="en" data-ui-edit-key="${k}" value="${(uiDictionary.en[k] || '').replace(/"/g, '&quot;')}" class="w-full border border-theme bg-brand-paper text-brand-ink px-2 py-1 rounded-sm text-xs">
                        </div>
                        <div>
                            <label class="text-[10px] text-brand-secondary block">HI</label>
                            <input type="text" data-ui-edit-lang="hi" data-ui-edit-key="${k}" value="${(uiDictionary.hi[k] || '').replace(/"/g, '&quot;')}" class="w-full border border-theme bg-brand-paper text-brand-ink px-2 py-1 rounded-sm text-xs">
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function saveAllButtonLabels() {
            siteData.uiOverrides = siteData.uiOverrides || { en: {}, hi: {} };
            document.querySelectorAll('[data-ui-edit-key]').forEach(input => {
                const lang = input.getAttribute('data-ui-edit-lang');
                const key = input.getAttribute('data-ui-edit-key');
                const val = input.value;
                if (lang && key) {
                    uiDictionary[lang][key] = val;
                    siteData.uiOverrides[lang][key] = val;
                }
            });
            persistSiteData();
            setLanguage(currentLang);
            renderCaseStudies();
            renderBlogs();
        }

        function applySavedInlineEdits() {
            if (!siteData.inlineEdits) return;
            document.querySelectorAll('[data-editable="true"]').forEach((el, index) => {
                const key = el.dataset.editKey || ('editable_node_' + index);
                el.dataset.editKey = key;
                if (siteData.inlineEdits[key] !== undefined) {
                    el.innerHTML = siteData.inlineEdits[key];
                }
            });
        }

        function addExpertiseCard() {
            const grid = document.getElementById('skills-grid');
            if (!grid) return;
            const div = document.createElement('div');
            div.className = 'border border-theme rounded-sm p-8 bg-transparent hover:bg-brand-light transition-colors duration-300';
            div.innerHTML = `
                <div class="text-2xl text-brand-ink mb-6"><i class="fas fa-feather-alt"></i></div>
                <h3 class="text-lg font-serif mb-3 text-brand-ink font-normal" data-editable="true" contenteditable="true">New Specialization</h3>
                <p class="text-brand-secondary text-sm leading-relaxed font-normal" data-editable="true" contenteditable="true">Click here to describe your new service or specialization.</p>
            `;
            grid.appendChild(div);
        }

        function addCustomSection() {
            const sub = document.getElementById('custom-sec-sub').value.trim() || 'Additional Highlights';
            const title = document.getElementById('custom-sec-title').value.trim();
            const content = document.getElementById('custom-sec-content').value.trim();
            if (!title || !content) return;

            siteData.customSections = siteData.customSections || [];
            siteData.customSections.push({
                id: 'custom_sec_' + Date.now(),
                sub,
                title,
                content
            });
            persistSiteData();
            renderCustomSections();
            renderStudioLists();
            document.getElementById('custom-sec-sub').value = '';
            document.getElementById('custom-sec-title').value = '';
            document.getElementById('custom-sec-content').value = '';
        }

        function deleteCustomSection(id) {
            siteData.customSections = (siteData.customSections || []).filter(s => s.id !== id);
            persistSiteData();
            renderCustomSections();
            renderStudioLists();
        }

        function resetAllSiteData() {
            localStorage.removeItem('yasir_site_cms_v2');
            siteData = JSON.parse(JSON.stringify(defaultSiteData));
            location.reload();
        }

        function exportUpdatedHTML() {
            const wasEditing = inlineEditActive;
            if (wasEditing) toggleInlineEditMode();
            closeStudioDrawer();
            document.body.classList.remove('owner-authenticated');

            let htmlClone = document.documentElement.outerHTML;
            if (ownerAuthenticated) document.body.classList.add('owner-authenticated');

            const serializedData = JSON.stringify(siteData, null, 4);
            htmlClone = htmlClone.replace(
                /const defaultSiteData = \{[\s\S]*?\n        \};/,
                `const defaultSiteData = ${serializedData};`
            );

            const blob = new Blob([`<!DOCTYPE html>\n` + htmlClone], { type: 'text/html;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'index.html';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        // --- STREAMING_CHUNK:Implementing Live SEO Audit and Diverse Multi-Topic Virtual Assistant... ---
        function runLiveSEOAudit() {
            const container = document.getElementById('seo-audit-results');
            if (!container) return;

            const titleText = document.title || '';
            const descMeta = document.querySelector('meta[name="description"]')?.content || '';
            const canonical = document.querySelector('link[rel="canonical"]')?.href || '';
            const hreflangs = document.querySelectorAll('link[rel="alternate"][hreflang]').length;
            const relMeLinks = document.querySelectorAll('a[rel*="me"]').length;
            const schemaEl = document.getElementById('entity-schema-graph');
            let schemaNodes = 0;
            try {
                const parsed = JSON.parse(schemaEl.textContent);
                schemaNodes = parsed['@graph'] ? parsed['@graph'].length : 1;
            } catch (e) {}

            const checks = [
                {
                    name: "Title Tag & Entity Keyword Alignment",
                    status: titleText.includes("Yasir Tehsin") && titleText.includes("AI Trainer"),
                    detail: `"${titleText}" (${titleText.length} chars — optimal for Google SERPs)`
                },
                {
                    name: "Meta Description & Snippet Control",
                    status: descMeta.length >= 110 && descMeta.length <= 175,
                    detail: `${descMeta.length} chars with max-snippet:-1 enabled for AI Search`
                },
                {
                    name: "Canonical & Bilingual Hreflang Tags",
                    status: Boolean(canonical) && hreflangs >= 3,
                    detail: `Canonical (${canonical}) + ${hreflangs} hreflang annotations (en, hi, x-default)`
                },
                {
                    name: "Unified JSON-LD Knowledge Graph (@graph)",
                    status: schemaNodes >= 5,
                    detail: `${schemaNodes} linked entities (WebSite, ProfilePage, Person, LocalBusiness, OfferCatalog, BlogPostings)`
                },
                {
                    name: "Bidirectional Identity Corroboration (rel='me')",
                    status: relMeLinks >= 6,
                    detail: `${relMeLinks} verified rel="me" platform links + CITLOB industry membership`
                },
                {
                    name: "Core Web Vitals & LCP Image Priority",
                    status: Boolean(document.querySelector('img[fetchpriority="high"]')),
                    detail: `Hero image configured with fetchpriority="high" and async decoding`
                }
            ];

            container.innerHTML = checks.map(c => `
                <div class="border border-theme p-4 rounded-sm bg-brand-paper flex flex-col justify-between">
                    <div class="flex items-center justify-between gap-2 mb-1.5">
                        <span class="font-serif text-sm text-brand-ink">${c.name}</span>
                        <span class="text-xs px-2 py-0.5 rounded-sm ${c.status ? 'bg-brand-ink text-brand-paper' : 'border border-theme text-brand-secondary'}">${c.status ? 'PASS ✓' : 'CHECK'}</span>
                    </div>
                    <p class="text-xs text-brand-secondary leading-relaxed">${c.detail}</p>
                </div>
            `).join('');
        }

        // Diverse Multi-Topic Virtual Assistant Chatbot
        let chatOpen = false;

        const botTopics = {
            en: [
                { text: "AI Training & RLHF", query: "ai" },
                { text: "Hindi/Urdu LLM QA", query: "lqa" },
                { text: "Python Automation", query: "python" },
                { text: "Media & Dubbing", query: "dubbing" },
                { text: "Poetry & Rekhta", query: "poetry" },
                { text: "Clients & Track Record", query: "clients" },
                { text: "Pilot & Pricing", query: "pricing" },
                { text: "View CV / Contact", query: "contact" }
            ],
            hi: [
                { text: "AI ट्रेनिंग और RLHF", query: "ai" },
                { text: "हिंदी/उर्दू LLM मूल्यांकन", query: "lqa" },
                { text: "Python ऑटोमेशन", query: "python" },
                { text: "मीडिया और डबिंग", query: "dubbing" },
                { text: "शायरी और रेख़्ता", query: "poetry" },
                { text: "क्लाइंट्स और अनुभव", query: "clients" },
                { text: "पायलट और कोटेशन", query: "pricing" },
                { text: "रिज़्यूमे / संपर्क", query: "contact" }
            ]
        };

        function toggleChat() {
            const win = document.getElementById('chat-window');
            chatOpen = !chatOpen;
            
            if (chatOpen) {
                win.classList.remove('hidden');
                setTimeout(() => {
                    win.classList.remove('opacity-0', 'scale-95');
                    win.classList.add('opacity-100', 'scale-100', 'flex');
                }, 10);
            } else {
                win.classList.remove('opacity-100', 'scale-100');
                win.classList.add('opacity-0', 'scale-95');
                setTimeout(() => {
                    win.classList.add('hidden');
                    win.classList.remove('flex');
                }, 300);
            }
        }
        
        function renderChatOptions() {
            const container = document.getElementById('chat-options');
            if (!container) return;
            container.innerHTML = '';
            
            botTopics[currentLang].forEach(opt => {
                const btn = document.createElement('button');
                btn.className = 'text-[11px] border border-theme rounded-sm px-2.5 py-1 bg-brand-paper hover:bg-brand-ink hover:text-brand-paper transition-colors text-brand-ink uppercase tracking-wider font-sans text-left shadow-sm';
                btn.innerText = opt.text;
                btn.onclick = () => handlePredefinedChat(opt.text, opt.query);
                container.appendChild(btn);
            });
        }

        function resetChatbot(lang) {
            const container = document.getElementById('chat-messages');
            if (!container) return;
            container.innerHTML = ''; 
            
            const welcomeMsg = lang === 'hi' 
                ? "नमस्ते! मैं यासिर तहसीन का वर्चुअल असिस्टेंट हूँ। आप नीचे दिए गए विषयों में से चुन सकते हैं या अपना कोई भी प्रश्न सीधे टाइप कर सकते हैं:"
                : "Hello! I'm Yasir Tehsin's virtual assistant. Explore any topic below—from AI training & Python QA to dubbing, poetry, or project quotes—or type a question directly:";
            
            addMessageToDOM(welcomeMsg, 'bot');
            renderChatOptions();
        }

        function handlePredefinedChat(userText, query) {
            addMessageToDOM(userText, 'user');
            respondWithBotDelay(query);
        }

        function handleCustomChatSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('chat-custom-input');
            const text = (input.value || '').trim();
            if (!text) return;
            input.value = '';
            addMessageToDOM(text, 'user');

            const lower = text.toLowerCase();
            let matchedQuery = 'general';
            if (lower.includes('python') || lower.includes('script') || lower.includes('pandas') || lower.includes('glossary') || lower.includes('auto')) matchedQuery = 'python';
            else if (lower.includes('nuqta') || lower.includes('chandrabindu') || lower.includes('orthograph') || lower.includes('hallucinat') || lower.includes('lqa') || lower.includes('quality')) matchedQuery = 'lqa';
            else if (lower.includes('ai') || lower.includes('llm') || lower.includes('rlhf') || lower.includes('train') || lower.includes('sft') || lower.includes('model')) matchedQuery = 'ai';
            else if (lower.includes('dub') || lower.includes('drama') || lower.includes('subtitle') || lower.includes('film') || lower.includes('media')) matchedQuery = 'dubbing';
            else if (lower.includes('poet') || lower.includes('rekhta') || lower.includes('urdu') || lower.includes('shayari') || lower.includes('ghazal') || lower.includes('book')) matchedQuery = 'poetry';
            else if (lower.includes('client') || lower.includes('fidel') || lower.includes('moefcc') || lower.includes('riverie') || lower.includes('pph') || lower.includes('productive') || lower.includes('citlob')) matchedQuery = 'clients';
            else if (lower.includes('price') || lower.includes('rate') || lower.includes('quote') || lower.includes('cost') || lower.includes('pilot') || lower.includes('hire')) matchedQuery = 'pricing';
            else if (lower.includes('contact') || lower.includes('email') || lower.includes('whatsapp') || lower.includes('phone') || lower.includes('cv') || lower.includes('resume')) matchedQuery = 'contact';

            respondWithBotDelay(matchedQuery);
        }

        function respondWithBotDelay(query) {
            const indicator = document.getElementById('typing-indicator');
            indicator.classList.remove('hidden');
            const container = document.getElementById('chat-messages');
            container.scrollTop = container.scrollHeight;

            setTimeout(() => {
                indicator.classList.add('hidden');
                const reply = generateBotResponse(query);
                addMessageToDOM(reply, 'bot');
                container.scrollTop = container.scrollHeight;
            }, 450);
        }

        function addMessageToDOM(text, sender) {
            const container = document.getElementById('chat-messages');
            const div = document.createElement('div');
            
            if (sender === 'user') {
                div.className = 'self-end bg-brand-ink text-brand-paper p-3 border border-theme rounded-sm max-w-[85%] leading-relaxed text-left font-sans text-xs sm:text-sm shadow-sm';
            } else {
                div.className = 'self-start bg-brand-paper text-brand-ink border border-theme rounded-sm p-3 max-w-[88%] leading-relaxed font-sans text-xs sm:text-sm shadow-sm';
            }
            
            div.innerHTML = text; 
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

        function generateBotResponse(query) {
            switch (query) {
                case "ai":
                    return "As an <b>AI Trainer</b> with 6+ years of linguistic experience, Yasir specializes in:<br>• <b>RLHF & Preference Ranking:</b> Evaluating ChatGPT, Claude, and Gemini responses in Hindi, Urdu, and English.<br>• <b>SFT Dataset Curation:</b> Writing gold-standard multilingual completions.<br>• <b>Model Alignment:</b> Auditing factual accuracy, instruction compliance, and cultural tone.";
                case "lqa":
                    return "Yasir's <b>LLM & Localization Quality Assurance (LQA)</b> covers semantic accuracy, factual grounding, instruction compliance, cultural register, and Devanagari/Urdu orthographic precision (such as resolving <em>Nuqta</em> and <em>Chandrabindu</em> errors). <button onclick=\"openCaseStudy('port3')\" class='underline font-bold'>Read the LLM Evaluation Case Study ↗</button>";
                case "python":
                    return "Yasir writes custom <b>Python, Pandas, and RegEx</b> scripts to automate localization bottlenecks—such as diffing a 700-term banking glossary, isolating 73 updated terms, and batch-updating 111 instances in 30 minutes. <button onclick=\"openCaseStudy('port1')\" class='underline font-bold'>View Python Case Study ↗</button>";
                case "dubbing":
                    return "For OTT series and micro-dramas, Yasir adapts English/Chinese scripts into natural, spoken Hindi and Urdu synchronized with actors' lip movements, pauses, and emotional delivery. <button onclick=\"openCaseStudy('port2')\" class='underline font-bold'>Read Dubbing Case Study ↗</button>";
                case "poetry":
                    return "Beyond technical localization, Yasir is a published Urdu and Hindi poet archived by the <b>Rekhta Foundation</b>. His literary craft ensures that creative and marketing transcreations carry authentic emotional weight. <a href='https://www.rekhta.org/poets/yasir-tahsin/all' target='_blank' class='underline font-bold'>Visit Rekhta Profile ↗</a>";
                case "clients":
                    return "Yasir has delivered localization, AI training, and LQA projects for organizations including:<br>• <b>FidelTech</b> (Fidel Softech)<br>• <b>MoEFCC</b> (Ministry of Environment, Forest & Climate Change)<br>• <b>Riverie</b><br>• <b>PPH</b> (Productive Playhouse)<br>He is also a member of <b>CITLOB</b> and verified on <b>ProZ</b>.";
                case "pricing":
                    return "Engagements are structured as <b>Per-Word</b> (translation/MTPE), <b>Hourly</b> (AI training/LQA), or <b>Project-Based</b>, and can begin with a calibrated <b>Paid Pilot</b>. <button onclick='openPilotModal()' class='underline font-bold'>Configure a Pilot or Custom Quote ↗</button>";
                case "contact":
                    return "You can reach Yasir directly at <b>yasirtehsin@gmail.com</b>, message on <a href='https://wa.me/918368691849' target='_blank' class='underline font-bold'>WhatsApp (+91 83686 91849)</a>, or <button onclick='openResumeModal()' class='underline font-bold'>View / Print his Résumé ↗</button>.";
                default:
                    return "Yasir specializes in <b>English–Hindi–Urdu Localization, AI Training (RLHF/SFT), Python QA Automation, and Literary Transcreation</b>. Click <button onclick='openPilotModal()' class='underline font-bold'>Scope a Pilot / Quote</button> or email <b>yasirtehsin@gmail.com</b> for a direct response.";
            }
        }

        // Initialize on load (supports ?lang=hi URL parameter and private owner shortcut Alt+E or ?edit=1)
        document.addEventListener('DOMContentLoaded', () => {
            loadSiteData();
            renderCaseStudies();
            renderClientsAndTestimonials();
            renderPublications();
            renderBlogs();
            renderCustomSections();
            applySavedInlineEdits();
            syncBlogSchemaGraph();

            const params = new URLSearchParams(window.location.search);
            const initialLang = params.get('lang') === 'hi' ? 'hi' : 'en';
            setLanguage(initialLang); 
            typeWriter();

            if (params.get('edit') === '1' || window.location.hash === '#admin') {
                handleOwnerTrigger();
            }

            document.addEventListener('keydown', (e) => {
                if (e.altKey && e.key.toLowerCase() === 'e') {
                    e.preventDefault();
                    if (!ownerAuthenticated) {
                        openOwnerAuthModal();
                    } else {
                        toggleInlineEditMode();
                    }
                }
            });
        });
    </script>
</body>
</html>