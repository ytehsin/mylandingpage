                        <option value="Python Glossary / QA Workflow Automation">Python Glossary / QA Workflow Automation</option>
                        <option value="Media Dubbing & Subtitle Adaptation">Media Dubbing & Subtitle Adaptation</option>
                        <option value="Financial, Government, Legal or Medical Translation">Financial, Government, Legal or Medical Translation</option>
                    </select>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
