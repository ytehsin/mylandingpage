        function openPilotModal() {
            const modal = document.getElementById('pilot-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closePilotModal() {
            const modal = document.getElementById('pilot-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function submitPilotBrief(channel) {
            const service = document.getElementById('pilot-service').value;
            const lang = document.getElementById('pilot-lang').value;
            const scope = document.getElementById('pilot-scope').value;
            const notes = document.getElementById('pilot-notes').value || 'Standard turnaround';
            const subject = encodeURIComponent(`Project Inquiry: ${service} (${lang})`);
            const body = encodeURIComponent(
                `Hello Yasir,\n\nI would like to scope a project with the following details:\n` +
                `• Service Track: ${service}\n` +
                `• Language Pair: ${lang}\n` +
                `• Engagement Model: ${scope}\n` +
                `• Project Notes: ${notes}\n\nPlease let me know your availability for a pilot or quote.`
            );
            if (channel === 'whatsapp') {
                window.open(`https://wa.me/918368691849?text=${body}`, '_blank');
            } else {
                window.location.href = `mailto:yasirtehsin@gmail.com?subject=${subject}&body=${body}`;
            }
        }

        // --- STREAMING_CHUNK:Implementing Studio CMS functions for Blogs, Images, Case Studies, Testimonials, and Books... ---
        function openStudioDrawer(tab = 'blog') {
            if (!ownerAuthenticated) {
                openOwnerAuthModal();
                return;
            }
            const drawer = document.getElementById('studio-drawer');
            drawer.classList.remove('hidden');
            drawer.classList.add('flex');
            renderStudioLists();
            renderButtonLabelsEditor();
            const passFeedback = document.getElementById('cms-pass-feedback');
            if (passFeedback) passFeedback.classList.add('hidden');
            switchStudioTab(tab);
        }

        function closeStudioDrawer() {
            const drawer = document.getElementById('studio-drawer');
            drawer.classList.add('hidden');
            drawer.classList.remove('flex');
        }

        function switchStudioTab(tab) {
            const tabs = ['blog', 'case', 'testimonials', 'publications', 'ui', 'seo'];
            tabs.forEach(t => {
                const contentEl = document.getElementById(`studio-tab-${t}`);
                const btnEl = document.getElementById(`tab-btn-${t}`);
                if (contentEl) {
                    if (t === tab) contentEl.classList.remove('hidden');
                    else contentEl.classList.add('hidden');
                }
                if (btnEl) {
                    btnEl.className = t === tab
                        ? 'px-3 py-1.5 border border-theme rounded-sm lang-switch-active'
                        : 'px-3 py-1.5 border border-theme rounded-sm lang-switch-inactive';
                }
            });
            if (tab === 'seo') runLiveSEOAudit();
            if (tab === 'ui') renderButtonLabelsEditor();
        }

