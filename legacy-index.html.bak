                        <button id="btn-en" onclick="setLanguage('en')" class="px-3 py-1 text-xs transition-all rounded-sm lang-switch-active" data-ui="btn_lang_en">EN</button>
                        <button id="btn-hi" onclick="setLanguage('hi')" class="px-3 py-1 text-xs transition-all rounded-sm lang-switch-inactive" data-ui="btn_lang_hi">HI</button>
